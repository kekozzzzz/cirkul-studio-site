<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Фотостудия «Циркуль»</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ title }} — Фотостудия «Циркуль»">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="logo logo-text" href="/">Циркуль.</a>
    <nav class="site-nav">
      <a href="/">Главная</a>
      <a href="/services/">Услуги</a>
      <a href="/rent/">Аренда</a>
      <a href="/booking/">Записаться</a>
    </nav>
    <div class="socials">
      <a href="https://vk.me/studio_circle" aria-label="VK">VK</a>
      <a href="https://t.me/circle_surgut" aria-label="Telegram">TG</a>
      <a href="https://instagram.com/circle_2.0" aria-label="Instagram">IG</a>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-main">
      <div class="footer-about">
        <a class="logo logo-text" href="/">Циркуль.</a>
        <p>Фотостудия «Циркуль», Сургут, ул. Маяковского 57, строение 3</p>
        <p>10:00–20:00 · <a href="tel:{{ site.phone_href }}">{{ site.phone_display }}</a></p>
        <div class="socials">
          <a href="https://vk.me/studio_circle" aria-label="VK">VK</a>
          <a href="https://t.me/circle_surgut" aria-label="Telegram">TG</a>
          <a href="https://instagram.com/circle_2.0" aria-label="Instagram">IG</a>
          <a href="https://youtube.com/@studiocircle" aria-label="YouTube">YT</a>
          <a href="https://2gis.ru" aria-label="2ГИС">2ГИС</a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Навигация</h4>
        <a href="/">Главная</a>
        <a href="/services/">Услуги</a>
        <a href="/rent/">Аренда</a>
        <a href="/booking/">Записаться</a>
      </div>
    </div>
    <p class="footer-copy">© Копирование материалов запрещено</p>
  </footer>

  <a class="floating-book" href="/booking/">Забронировать онлайн</a>

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
