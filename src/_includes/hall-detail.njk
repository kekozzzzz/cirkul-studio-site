---
layout: base.njk
eleventyComputed:
  title: "{{ name }}"
  description: "{{ description }}"
---
{% set photos = gallery if gallery and gallery.length else ([image] if image else []) %}
<div class="hall-nav-top">
  <a class="hall-back" href="/services/">← Все залы</a>
</div>

<article class="hall-detail">
  {% if photos.length %}
    <div class="hall-gallery">
      <div class="hall-gallery-scroll">
        {% for photo in photos %}
          <img src="{{ photo }}" alt="{{ name }}" loading="lazy">
        {% endfor %}
      </div>
      {% if photos.length > 1 %}
        <button class="gallery-arrow prev" type="button" aria-label="Предыдущее фото">‹</button>
        <button class="gallery-arrow next" type="button" aria-label="Следующее фото">›</button>
      {% endif %}
    </div>
  {% endif %}

  <h1>{{ name }}</h1>

  {% if description %}
    <p class="hall-description">{{ description }}</p>
  {% endif %}

  <div class="hall-detail-meta">
    <div class="meta-card">
      <h4>Цена</h4>
      <p>{{ price_hint }}</p>
    </div>
    {% if capacity_included %}
      <div class="meta-card">
        <h4>Вместимость</h4>
        <p>до {{ capacity_included }} чел. включено в цену{% if capacity_total %} (всего вмещает до {{ capacity_total }}){% endif %}</p>
      </div>
    {% endif %}
    {% if hours %}
      <div class="meta-card">
        <h4>Часы работы</h4>
        <p>{{ hours }}</p>
      </div>
    {% endif %}
  </div>

  {% if features and features.length %}
    <h3>Преимущества зала</h3>
    <ul class="hall-features">
      {% for f in features %}<li>{{ f }}</li>{% endfor %}
    </ul>
  {% endif %}

  <a class="btn" href="{{ booking_url }}" target="_blank" rel="noopener">Забронировать</a>
</article>
