---
layout: base.njk
eleventyComputed:
  title: "{{ name }}"
  description: "{{ description }}"
---
{% set photos = gallery if gallery and gallery.length else ([image] if image else []) %}
<div class="hall-nav-top">
  <a class="hall-back" href="/services/">← Все залы</a>
  {% for h in collections.halls %}
    {% if h.url == page.url %}
      {% set nextHall = collections.halls[(loop.index0 + 1) % collections.halls.length] %}
      <a class="hall-next" href="{{ nextHall.url }}">Следующий зал: {{ nextHall.data.name }} →</a>
    {% endif %}
  {% endfor %}
</div>

<article class="hall-detail">
  {% if photos.length %}
    <div class="halls-slider gallery-slider">
      <div class="halls-slider-track">
        {% for photo in photos %}
          <div class="gallery-slide"><img src="{{ photo }}" alt="{{ name }}" loading="lazy"></div>
        {% endfor %}
      </div>
      {% if photos.length > 1 %}
        <button class="slider-arrow prev" type="button" aria-label="Предыдущее фото">‹</button>
        <button class="slider-arrow next" type="button" aria-label="Следующее фото">›</button>
        <div class="slider-dots">
          {% for photo in photos %}<button class="slider-dot" type="button" aria-label="Фото {{ loop.index }}"></button>{% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <h1>{{ name }}</h1>

  {% if description %}
    <p class="hall-description">{{ description }}</p>
  {% endif %}

  <div class="hall-detail-meta">
    <div class="meta-card">
      <h4>Цена</h4>
      <p>{{ price_hint }}</p>
    </div>
    {% if capacity_included %}
      <div class="meta-card">
        <h4>Вместимость</h4>
        <p>до {{ capacity_included }} чел. включено в цену{% if capacity_total %} (всего вмещает до {{ capacity_total }}){% endif %}</p>
      </div>
    {% endif %}
    {% if hours %}
      <div class="meta-card">
        <h4>Часы работы</h4>
        <p>{{ hours }}</p>
      </div>
    {% endif %}
  </div>

  {% if features and features.length %}
    <h3>Преимущества зала</h3>
    <ul class="hall-features">
      {% for f in features %}<li>{{ f }}</li>{% endfor %}
    </ul>
  {% endif %}

  <a class="btn" href="#book">Забронировать</a>
</article>

<section id="book" class="booking-embed">
  <h3>Забронировать «{{ name }}»</h3>
  <div class="booking-iframe-wrap">
    <iframe src="{{ booking_url or 'https://circle.cue.business/services' }}" loading="lazy" title="Бронирование зала «{{ name }}»"></iframe>
  </div>
  <p class="booking-fallback">
    Если календарь не загрузился — <a href="{{ booking_url or 'https://circle.cue.business' }}" target="_blank" rel="noopener">откройте бронирование в новой вкладке</a>.
  </p>
</section>
